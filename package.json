{
  "name": "tetorica-development",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for Tetorica sound-chip runtime and VGM Analyzer",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyorohiro/hello_ymfm_wasm.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "buffer": "^6.0.3",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "isomorphic-git": "^1.43.3",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "psf:batch": "node scripts/check_psf_batch.mjs",
    "test:psf-batch": "node --test scripts/psf_batch_inputs.test.mjs scripts/psf_batch_worker.test.mjs scripts/check_psf_batch.test.mjs",
    "test:psf-capture-loop": "node scripts/check_psf_capture_loop_layout.mjs",
    "build:sid": "sh scripts/build_sid_wasm.sh",
    "test:sid": "node --test test/runtime/sid.test.mjs && node scripts/sid_artifacts.mjs --check",
    "test:sid:native": "node scripts/check_sid_native.mjs",
    "test:sid:waveoff": "node --test test/sid_waveoff.test.mjs",
    "test:sid:browser": "node scripts/check_sid_lab_browser.cjs",
    "test:sid-synth": "node --test docs/synth-sid/*.test.mjs scripts/package_itch_sid_synth.test.mjs",
    "test:sid-synth:browser": "node scripts/check_sid_synth_browser.cjs",
    "pack:sid-synth": "sh scripts/package_itch_sid_synth.sh",
    "prepare:sid-reference": "node scripts/prepare_sid_reference.mjs",
    "test:sid-reference": "node --test test/sid_psid.test.mjs test/sid_trace.test.mjs test/sid_reference.test.mjs",
    "check:sid-reference": "node scripts/check_sid_reference.mjs",
    "sid:reference": "node tetorica_src/cli/sid_reference.mjs",
    "build:sid-player": "sh scripts/build_sid_player_wasm.sh",
    "test:sid-player": "node --test test/sid_psid_browser.test.mjs test/sid_player_integration.test.mjs test/sid_player_audio.test.mjs test/sid_player_processor.test.mjs test/sid_player_models.test.mjs test/sid_player_8580.test.mjs test/sid_player_hvsc_metadata.test.mjs test/sid_player_roms.test.mjs test/sid_player_voice_snapshot.test.mjs test/sid_player_voice_capture.test.mjs test/sid_rsid.test.mjs test/rsid_player_integration.test.mjs test/psid_cia_player_integration.test.mjs test/psid_vbi_machine_integration.test.mjs scripts/package_sid_player.test.mjs",
    "build:sid-rsid": "sh scripts/build_sid_rsid_wasm.sh",
    "test:sid-player:browser": "node scripts/check_sid_player_browser.cjs",
    "test:sid-voice:browser": "node scripts/check_sid_voice_capture_browser.cjs",
    "check:sid-corpus": "node scripts/check_sid_corpus.mjs",
    "test:sid-corpus": "node --test test/sid_corpus.test.mjs",
    "pack:sid-player": "node scripts/package_sid_player.mjs",
    "build:virtual-files": "node scripts/build_virtual_files.mjs && node scripts/build_virtual_git.mjs",
    "test:virtual-files": "node --test packages/virtual-files/tests/*.test.mjs",
    "test:virtual-files:package": "node scripts/build_virtual_files.mjs && node scripts/check_virtual_files_package.mjs",
    "build": "npm run build:vgm",
    "test": "node --test --test-concurrency=2 test/*.test.mjs test/runtime/*.test.mjs",
    "test:runtime": "node --test --test-concurrency=2 test/runtime/*.test.mjs",
    "test:runtime:types": "tsc --noEmit --strict --allowJs --module nodenext --moduleResolution nodenext --target es2022 test/runtime/scspsynth.types.test.ts",
    "test:analyzer": "node --test --test-concurrency=2 test/runtime/*.test.mjs docs/vgm_analyzer/*.test.mjs",
    "sync:runtime-artifacts": "node scripts/sync_runtime_artifacts.mjs",
    "check:runtime-artifacts": "node scripts/sync_runtime_artifacts.mjs --check",
    "sync:tutorials": "node scripts/sync_tutorial_sources.mjs",
    "check:tutorials": "node scripts/sync_tutorial_sources.mjs --check",
    "test:runtime-artifacts": "node --test test/runtime_artifacts.test.mjs test/runtime_artifact_builders.test.mjs scripts/runtime_artifact_profiles.test.mjs scripts/runtime_staging_paths.test.mjs",
    "test:wasm:sdk": "node scripts/check_wasm_sdk.mjs",
    "build:wonderswan": "sh scripts/build_wonderswan_wasm.sh",
    "test:wonderswan": "node scripts/check_wonderswan_core.mjs",
    "test:wonderswan:browser": "node scripts/check_wonderswan_core_browser.cjs",
    "test:sbi": "node --test docs/vgm_analyzer/sbi_export.test.mjs docs/vgm_analyzer/sbi_ui.test.mjs docs/vgm_analyzer/sbi_info.test.mjs test/sbi.test.mjs",
    "pack:check": "npm run pack:vgm -- --dry-run",
    "pack": "npm run pack:vgm --",
    "build:fm2612": "node scripts/build_fm2612_package.mjs",
    "pack:fm2612": "node scripts/pack_fm2612.mjs",
    "test:fm2612": "node scripts/check_fm2612_package.mjs",
    "test:fm2612:browser": "npm run build:fm2612 && node scripts/check_megacd_browser.cjs && node scripts/check_megasynth_offline_browser.cjs",
    "setup:browser": "playwright install chromium",
    "test:fm2612:types": "node scripts/check_fm2612_types.mjs",
    "test:scsp-synth": "node --test docs/synth-scsp/*.test.mjs scripts/package_itch_scsp_synth.test.mjs",
    "pack:scsp-synth": "sh scripts/package_itch_scsp_synth.sh",
    "test:scsp-synth:browser": "node scripts/check_scsp_synth_browser.cjs",
    "test:spu-synth": "node --test docs/synth-spu/*.test.mjs scripts/package_itch_spu_synth.test.mjs",
    "test:spu-synth:browser": "node scripts/check_spu_synth_browser.cjs",
    "pack:spu-synth": "sh scripts/package_itch_spu_synth.sh",
    "test:dmg-synth": "node --test docs/synth-dmg/*.test.mjs scripts/package_itch_dmg_synth.test.mjs",
    "test:gameboy-synth": "npm run test:dmg-synth",
    "test:dmg-synth:browser": "node scripts/check_dmg_synth_browser.cjs",
    "test:gameboy-synth:browser": "npm run test:dmg-synth:browser",
    "pack:dmg-synth": "sh scripts/package_itch_dmg_synth.sh",
    "pack:gameboy-synth": "npm run pack:dmg-synth --",
    "test:nes-synth": "npm run test:2a03-synth",
    "test:nes-synth:browser": "npm run test:2a03-synth:browser",
    "pack:nes-synth": "npm run pack:2a03-synth --",
    "build:vgm": "node scripts/build_cli.mjs",
    "pack:vgm": "node scripts/pack_cli.mjs",
    "pack:vgm:check": "npm run pack:vgm -- --dry-run",
    "test:cdrom2": "node scripts/check_cdda_core.mjs && node scripts/check_msm5205_core.mjs && node --test test/runtime/cdda_*.test.mjs test/runtime/msm5205_*.test.mjs",
    "test:2a03-synth": "node --test docs/synth-2a03/*.test.mjs scripts/package_itch_2a03_synth.test.mjs",
    "test:2a03-synth:browser": "node scripts/check_2a03_synth_browser.cjs",
    "pack:2a03-synth": "sh scripts/package_itch_2a03_synth.sh",
    "test:huc6280-synth": "node --test docs/synth-huc6280/*.test.mjs scripts/package_itch_huc6280_synth.test.mjs",
    "test:huc6280-synth:browser": "node scripts/check_huc6280_synth_browser.cjs",
    "pack:huc6280-synth": "sh scripts/package_itch_huc6280_synth.sh",
    "test:snes-synth": "node --test docs/synth-snes/*.test.mjs scripts/package_itch_snes_synth.test.mjs",
    "test:snes-synth:browser": "node scripts/check_snes_synth_browser.cjs",
    "pack:snes-synth": "sh scripts/package_itch_snes_synth.sh"
  }
}
