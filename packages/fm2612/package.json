{
  "name": "tetorica-fm2612",
  "version": "0.2.23",
  "description": "Tetorica sound chip WASM cores, Synth helpers and browser audio runtime",
  "type": "module",
  "license": "BSD-3-Clause",
  "homepage": "https://kyorohiro.github.io/hello_ymfm_wasm/playground/index.html",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyorohiro/hello_ymfm_wasm.git"
  },
  "exports": {
    ".": {
      "types": "./soundchip.d.ts",
      "import": "./soundchip.js",
      "default": "./soundchip.js"
    },
    "./assets": {
      "types": "./package_assets.d.ts",
      "import": "./package_assets.js",
      "default": "./package_assets.js"
    },
    "./node": {
      "types": "./node/megasynth.d.mts",
      "import": "./node/megasynth.mjs",
      "default": "./node/megasynth.mjs"
    },
    "./node/transports": {
      "types": "./node/chip_transports.d.mts",
      "import": "./node/chip_transports.mjs",
      "default": "./node/chip_transports.mjs"
    },
    "./generated/*": "./generated/*",
    "./*.js": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "default": "./*.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "default": "./*.js"
    }
  },
  "peerDependencies": {
    "audify": "^1.10.1"
  },
  "peerDependenciesMeta": {
    "audify": {
      "optional": true
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "*.wasm",
    "tetorica_ym2608_adpcm_rom.bin",
    "generated/",
    "assets/",
    "licenses/",
    "sources/",
    "node/",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt",
    "RUNTIME.md",
    "soundchip.md",
    "runtime-manifest.json",
    "nes_apu_vendor/",
    "msfa_dx7/"
  ],
  "keywords": [
    "chiptune",
    "sound-chip",
    "audio",
    "ym2612",
    "ym2608",
    "ym2151",
    "ay8910",
    "ym2413",
    "opll",
    "msx",
    "msx-audio",
    "ym3812",
    "ymf262",
    "opl",
    "opl2",
    "opl3",
    "fm-synthesis",
    "wasm",
    "webassembly",
    "audioworklet",
    "synthesizer",
    "sega-genesis",
    "mega-drive",
    "32x",
    "pwm",
    "typescript",
    "nodejs",
    "ymfm",
    "nes",
    "fds",
    "dpcm",
    "dx7",
    "msfa",
    "sysex",
    "snes",
    "spc700",
    "s-dsp",
    "spc",
    "brr"
  ],
  "types": "./soundchip.d.ts"
}
