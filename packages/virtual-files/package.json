{
  "name": "tetorica-virtual-files",
  "version": "0.4.0",
  "description": "Memory filesystem and lightweight command shell for browser and Node.js editors",
  "type": "module",
  "license": "BSD-3-Clause",
  "keywords": [
    "virtual-filesystem",
    "filesystem",
    "in-memory",
    "browser",
    "nodejs",
    "shell",
    "git",
    "snapshots",
    "checkpoints",
    "synchronization"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyorohiro/hello_ymfm_wasm.git",
    "directory": "packages/virtual-files"
  },
  "homepage": "https://github.com/kyorohiro/hello_ymfm_wasm/tree/main/packages/virtual-files",
  "bugs": {
    "url": "https://github.com/kyorohiro/hello_ymfm_wasm/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./shell.js": {
      "types": "./src/shell.d.ts",
      "import": "./src/shell.js"
    },
    "./git": {
      "types": "./src/git.d.ts",
      "import": "./src/git.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.43.3",
    "diff": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "buffer": {"optional": true},
    "isomorphic-git": {"optional": true},
    "diff": {"optional": true}
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
