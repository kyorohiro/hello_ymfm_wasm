  "behavior": {
    "control": "Selected CH only · Dry checkbox beside the existing CH selector; default Off. Numbered activity buttons and the dropdown share the same selection.",
    "softwareFeature": true,
    "selectedOutput": "One physical voice, post-ADSR/PMON/Noise and voice volume, saturated into an isolated empty int16 bus, then the original main volume and SPUCNT mute.",
    "sharedReverb": "Excluded from selected Dry output. Original shared reverb processes all voices and RAM normally and is heard again when Off returns to the full mix.",
    "preserved": [
      "all 24 voice processing",
      "PMON source oscillators even with zero direct volume",
      "shared Noise state",
      "ADSR/decoder timing",
      "CPU and SPU RAM",
      "registers/IRQs/transfers",
      "original full stereo mix",
      "audible Live/Capture snapshots",
      "editor instrument"
    ],
    "independence": "Listening mode works with Live Off and does not change paused keyboard audition or permanent Capture.",
    "retention": "Full stereo and frame-major 24x stereo Dry PCM retained only in bounded lookahead; approximately 2 MiB extra with default settings. One selected AudioBuffer per segment, not 24 audio routes.",
    "switching": "Coalesced short fade, trim at the exact consumed cursor, and reschedule only retained unplayed frames. No source rerender or forward seek.",
    "fade": {
      "closeSeconds": 0.008,
      "openSeconds": 0.004,
      "start": "Aligned to the first new BufferSource start. freshInput reanchors an interrupted opening, including Pause followed immediately by Resume. Default Code open behavior remains unchanged."
    }
