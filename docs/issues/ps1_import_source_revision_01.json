    "playground/playground_ps1_psf.js": {
      "before": {
        "bytes": 13414,
        "sha256": "9b831e800f824e83a5ab581cbbfcdb494f2a083f39c783c2e11464010364169b"
      },
      "after": {
        "bytes": 20535,
        "sha256": "3fe596a1121a34ff9f20cf496fd491d6adf31155f71bd8d374d43d32eeec4082"
      },
      "reverseHunks": [
        {
          "afterOffset": 226,
          "afterBytes": 106,
          "beforeText": "import {MAX_VAB_FILE_BYTES,readVab,prepareVabTone} from './playground_ps1_vab.js';\n"
        },
        {
          "afterOffset": 9491,
          "afterBytes": 376,
          "beforeText": "/** Only contiguous, fully loaded VAB headers+bodies are matched initially.\n * A playable Tone is insufficient when the assumed body contains another\n * validated header. This is a conservative layout guard, not a VH/VB resolver. */\n"
        },
        {
          "afterOffset": 9913,
          "afterBytes": 131,
          "beforeText": "  const banks=[],headers=[],sequences=[],records=[],diagnostics=[];let candidates=0,extracted=0;\n"
        },
        {
          "afterOffset": 10113,
          "afterBytes": 1185,
          "beforeText": "  const loaded=(start,end)=>coverage.subarray(start,end).every(byte=>byte===1);\n"
        },
        {
          "afterOffset": 11371,
          "afterBytes": 76,
          "beforeText": "    // Sony SEQ v1 header: big-endian version, resolution, tempo and rhythm.\n    // https://psx-spx.consoledev.net/cdromfileformats/#seq-single-sequence\n    // Magic alone (or SEP's shared magic) does not establish a conflict.\n    // Some SEQs leave both rhythm bytes zero (observed in Crash Bandicoot).\n"
        },
        {
          "afterOffset": 12017,
          "afterBytes": 351,
          "beforeText": "    const record={address:at,size,headerBytes};records.push(record);\n    if(size<0xa20||size>MAX_VAB_FILE_BYTES||at+size>ram.length||headerBytes>size||!loaded(at,at+headerBytes)) {\n      Object.assign(record,{code:'unloaded-or-invalid-range',reason:'header/body range is invalid or not fully loaded'});continue;\n"
        },
        {
          "afterOffset": 12384,
          "afterBytes": 804,
          "beforeText": "      // Body bytes are not interpreted by readVab. Validate the whole header\n      // even if its own VB is missing or none of its Tones can be prepared.\n      readVab(ram.subarray(at,at+size));headers.push(record);\n      if(!loaded(at,at+size))Object.assign(record,{code:'unloaded-or-invalid-range',reason:'header/body range is invalid or not fully loaded'});\n    } catch(error){Object.assign(record,{code:'invalid-vab',reason:error.message});}\n"
        },
        {
          "afterOffset": 13192,
          "afterBytes": 6050,
          "beforeText": ""
        },
        {
          "afterOffset": 19275,
          "afterBytes": 70,
          "beforeText": "    const {address:at,size,headerBytes}=record;\n"
        },
        {
          "afterOffset": 19368,
          "afterBytes": 107,
          "beforeText": "      const nested=headers.find(other=>other.address>=at+headerBytes&&other.address<at+size);\n      const sequence=sequences.find(address=>address>=at+headerBytes&&address<at+size);\n      if(nested)Object.assign(record,{code:'ambiguous-vab-body',conflictAddress:nested.address,reason:`assumed sample body contains another VAB header at ${ramAddress(nested.address)}; VH/VB mapping is uncertain`});\n      else if(sequence!==undefined)Object.assign(record,{code:'ambiguous-seq-body',conflictAddress:sequence,reason:`assumed sample body contains a structured SEQ header at ${ramAddress(sequence)}; VH/VB mapping is uncertain`});\n    }\n    if(!record.code) {\n      const bank=readVab(ram.subarray(at,at+size));\n"
        },
        {
          "afterOffset": 19791,
          "afterBytes": 226,
          "beforeText": "        banks.push({bank,address:at,bytes:size});\n"
        }
      ]
    },
