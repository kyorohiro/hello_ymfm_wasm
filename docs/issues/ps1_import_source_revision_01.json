            },
            {
              "afterOffset": 6902,
              "afterBytes": 48,
              "beforeText": "  let expanded=0,visits=0;\n"
            },
            {
              "afterOffset": 8052,
              "afterBytes": 182,
              "beforeText": ""
            },
            {
              "afterOffset": 8273,
              "afterBytes": 272,
              "beforeText": "    if(record.tags.has('_lib'))await load(library(record,record.tags.get('_lib')),next);\n    const {address,data}=await segment(record);check(signal);ram.set(data,address);coverage.fill(1,address,address+data.length);loadedFiles.push(record.path);\n"
            },
            {
              "afterOffset": 8671,
              "afterBytes": 150,
              "beforeText": ""
            },
            {
              "afterOffset": 8825,
              "afterBytes": 214,
              "beforeText": "  await load(set.records.get(entryPath));\n  return {ram,coverage,loadedFiles,expandedBytes:expanded,entryPath};\n"
            }
          ]
        }
      }
