    "playground/playground_ps1_vab_panel.js": {
      "before": {
        "bytes": 11671,
        "sha256": "f2e4e2d2ea023833d99bda456d5333343761e52a9495750e5b50691adfcec21d"
      },
      "after": {
        "bytes": 12043,
        "sha256": "13aebbebf1e572c5a5ac666b41951976f836f0bc5ea876cef028cee528944876"
      },
      "reverseHunks": [
        {
          "afterOffset": 74,
          "afterBytes": 227,
          "beforeText": "import {MAX_VAB_FILE_BYTES, readVab, prepareVabTone} from './playground_ps1_vab.js';\nimport {PSF_FILES,readPsfFileSet,extractPsfVabs,psfRejectionSummary} from './playground_ps1_psf.js';\n"
        },
        {
          "afterOffset": 3832,
          "afterBytes": 989,
          "beforeText": "  const help=make('p','Standard Sony VAB v6/v7, or matching VH + VB. For PSF1/MiniPSF, select the song and all referenced PSFLib files together, or open their folder; choose a PSF entry and extract its banks. Static extraction finds contiguous VAB banks in the expanded data. Separate VH/VB layouts, custom formats and runtime-packed banks may not be found. PSF2 and song playback are not supported. No game code is executed. Load one Tone into the selected Voice, then Hold to play, Sustain play or Use Keyboard. Other voices keep their instruments. Stop running code first if it controls this voice. Imports stay in live SPU RAM; Run/reset may replace them. Key zones/layers and driver vibrato/portamento are not applied; volume/pan are approximate. Reverb send uses current shared settings.');help.className='subtext';root.appendChild(help);\n"
        },
        {
          "afterOffset": 6215,
          "afterBytes": 302,
          "beforeText": "      const reason=availability.get(tone.sample),option=make('option',`Program ${tone.program} · Tone ${tone.index} · Sample ${tone.sample} · center ${tone.center} · shift +${tone.shift}/128 st · keys ${tone.keyLow}–${tone.keyHigh}${reason?' · unavailable':''}`);\n"
        },
        {
          "afterOffset": 8839,
          "afterBytes": 528,
          "beforeText": "      if(!result.banks.length){message(`No standard VAB found in ${song.value}. Separate VH/VB layouts, custom or runtime-packed banks need further support.${psfRejectionSummary(result)}${bank?' Previous bank is kept.':''}`);return;}\n      showBanks(result.banks.map(found=>({bank:found.bank,name:`${song.value} · VAB @0x${(0x80000000+found.address).toString(16)}`})));\n"
        }
      ]
    }
  },
