        {
          "afterOffset": 11220,
          "afterBytes": 750,
          "beforeText": "class Node {\n  constructor(doc, tag) { this.ownerDocument = doc; this.tagName = tag.toUpperCase(); this.children = []; this.dataset = {}; this.attributes = new Map(); this.content = ''; this.open = false; this.hidden = false; }\n  set textContent(value) { this.content = value; this.ownerDocument.writes++; }\n  get textContent() { return this.content; }\n  append(...children) { this.children.push(...children); this.ownerDocument.writes++; }\n  replaceChildren(...children) { this.children = children; this.ownerDocument.writes++; }\n"
        },
        {
          "afterOffset": 12132,
