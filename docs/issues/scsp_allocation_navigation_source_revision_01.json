        {
          "afterOffset": 13807,
          "afterBytes": 260,
          "beforeText": "/** Stable passive DOM: polling never replaces controls, steals focus, or closes help. */\nexport function setupScspSlotAllocationView({ root } = {}) {\n  if (!root?.ownerDocument) return { update() {}, dispose() {} };\n"
