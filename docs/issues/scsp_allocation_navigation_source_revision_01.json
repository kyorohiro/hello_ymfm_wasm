          "beforeText": " for(const name of related){const bytes=await readFile(resolve(root,name));if(unchanged.includes(name))assert.deepEqual(bytes,historical(name),'Audio/observer/runtime/package inputs stay byte-identical: '+name);relatedSources[name]=record(bytes);}\n for(const name of reports){const bytes=await readFile(resolve(root,name));assert.deepEqual(bytes,historical(name),'Historical native/source/SSF evidence remains immutable: '+name);reportRecords[name]=record(bytes);}\n"
        },
