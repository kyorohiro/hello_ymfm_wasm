{
  "schemaVersion": 1,
  "scope": "gameboy-main-worker-timed-api-connection",
  "baseCommit": "33f71b326bdc51bc6d6be4e7f1394d5dc4f362e3",
  "reason": "Expose the existing Game Boy timed capability through Main primary and transferred Worker clients; send gameboyTimed as an acknowledged control RPC with one performance timestamp; retain configured voice/initialization metadata and Gate intent on Worker raw writes. The four connection changes are validated exactly, with cache-token-only browser mirrors and one exact cache-version tool extension. No Worklet renderer, operation resolver, performance clock/queue, core, WASM, mixer gain or old PCM proof is changed.",
  "verification": [
    "Six actual Main/Worker routing tests cover atomic entry/Apply/Stop and ownership; installed-candidate browser verification is recorded separately by the authorized npm publication task."
  ],
