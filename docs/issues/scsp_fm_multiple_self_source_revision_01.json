    "docs/synth-scsp/patch.js": {
      "before": {
        "bytes": 6970,
        "sha256": "1a9687d11c69efa8b0838d6601035e5f57e0c3f7ef36d7e3380e43ac039d3445"
      },
      "after": {
        "bytes": 7596,
        "sha256": "2f928349308d5086d54c2636a5f1380b3a20c66a8f6c582fbe1ac7b9502f261b"
      },
      "reverseHunks": [
        {
          "afterOffset": 229,
          "afterBytes": 158,
          "beforeText": "import {SOURCE_COUNT,OPERATOR_KEYS,voiceCommands,operatorCount,customRouting,operatorDepths,hasSelfFeedback} from './routing.js?v=scsp-fm-multi-self-1';\n"
        },
        {
          "afterOffset": 2833,
          "afterBytes": 335,
          "beforeText": "  if(value.version>=1&&value.version<7&&Object.hasOwn(value.fm??{},'depths'))throw new TypeError('Per-operator FM depths require preset version 7');\n  if(value.version>=1&&value.version<5&&(value.fm?.algorithm==='custom'||Object.hasOwn(value.fm??{},'custom')))throw new TypeError('Custom FM routing requires preset version 5');\n"
        },
        {
          "afterOffset": 3195,
          "afterBytes": 19,
          "beforeText": "  if(value.version===1){\n"
        },
        {
          "afterOffset": 3318,
          "afterBytes": 2713,
          "beforeText": "  }else if(value.version===2||value.version===3||value.version===4||value.version===5||value.version===6||value.version===7||value.version===8||value.version===9){\n    if(value.version===2&&!['pcm','fm2'].includes(value.mode))throw new TypeError('Version 2 supports PCM or 2-op');\n    if(value.version===5&&(value.mode!=='fm2'||value.fm?.algorithm!=='custom'||!Object.hasOwn(value.fm??{},'custom')))throw new TypeError('Preset version 5 requires complete custom 2-op FM routing');\n    if(value.version===6&&(!['fm4','fm6'].includes(value.mode)||value.fm?.algorithm!=='custom'||!Object.hasOwn(value.fm??{},'custom')))throw new TypeError('Preset version 6 requires complete custom 4-op or 6-op FM routing');\n    if(value.version===7&&(!Object.hasOwn(value.fm??{},'depths')||value.fm?.algorithm==='custom'&&!Object.hasOwn(value.fm,'custom')))throw new TypeError('Preset version 7 requires complete operator depths and explicit Custom routing');\n    if(value.version===8&&(value.mode!=='fm2'||value.fm?.algorithm!=='custom'||!Object.hasOwn(value.fm??{},'custom')))throw new TypeError('Preset version 8 requires complete Custom 2-op self feedback');\n    if(value.version===9&&(!['fm4','fm6'].includes(value.mode)||value.fm?.algorithm!=='custom'||!Object.hasOwn(value.fm??{},'custom')))throw new TypeError('Preset version 9 requires complete Custom 4-op or 6-op self feedback');\n    config=settings({...value,effect:value.version>=4?value.effect:undefined});\n    const self=config.fm.custom&&hasSelfFeedback(config.fm.custom);\n    if(value.version<8&&self)throw new TypeError('Self feedback requires preset version 8 for 2-op or 9 for 4/6-op');\n    if(value.version===8&&(config.mode!=='fm2'||config.fm.algorithm!=='custom'||!self))throw new TypeError('Preset version 8 requires Custom 2-op with an actual self-feedback connection');\n    if(value.version===9&&(!['fm4','fm6'].includes(config.mode)||config.fm.algorithm!=='custom'||!self))throw new TypeError('Preset version 9 requires Custom 4-op or 6-op with an actual self-feedback connection');\n    for(const key of OPERATOR_KEYS.slice(0,value.version===2?2:SOURCE_COUNT)){\n"
        },
        {
          "afterOffset": 6322,
          "afterBytes": 60,
          "beforeText": "    if(value.version===2)operators.modulator.voice.directLevel=7;\n"
        },
        {
          "afterOffset": 7161,
          "afterBytes": 313,
          "beforeText": "  const value={format:'tetorica-scsp-voice',version:custom&&hasSelfFeedback(validated.fm.custom)?(validated.mode==='fm2'?8:9):validated.fm.depths?7:custom?(validated.mode==='fm2'?5:6):4,...validated,operators:Object.fromEntries(Object.entries(operators).map(([kind,operator])=>{\n"
        }
