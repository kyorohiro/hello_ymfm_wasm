  "behavior": {
    "fm": "Draw updates the same RAM endpoint without Key On/Off, cursor reset or held/release-owner loss. Sample length, metadata, tuning and loop settings stay fixed.",
    "code": "Shared-editor sample notes and Root overrides persist; custom Code RAM and a pending Stop are fenced before editor mutation.",
    "recording": "editSample is a nonstopping Event Rec/Looper operation. Playback changes prepared banks without key or register rewrites; Use current sound skips the recorded drawing.",
    "huc": "Wave-only updates retain logical owners, pitch and software-envelope start/release times. Only previously enabled, still-owned unexpired gates are restored after the hardware upload.",
    "otherChanges": "Loading a different sample/preset, source/topology changes and FM builtin replacement keep their existing stop semantics."
  },
  "limits": [
    "HuC hardware waveform upload resets the affected wave index/oscillator phase; pre-edit phase is not preserved.",
    "SPU and S-DSP behavior is outside this change.",
    "No listening or physical audio output was used."
  ],
