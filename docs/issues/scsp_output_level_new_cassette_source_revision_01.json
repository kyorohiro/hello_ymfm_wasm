      },
      "reverseHunks": [
        {
          "afterOffset": 253,
          "afterBytes": 215,
          "beforeText": "const BALANCE=.125,DEADLINE=15000;\n"
        },
        {
          "afterOffset": 675,
          "afterBytes": 100,
          "beforeText": " * optional Code FX route, Stop fade and Master. outputNode is post-Master and\n"
        },
        {
          "afterOffset": 1424,
          "afterBytes": 153,
          "beforeText": "  let node,balance,master,codeFade,songInput,closed=false,closing=null,sequence=0,startupTimer,readyResolve,rejectStartup,fatal=null;\n"
        },
        {
          "afterOffset": 2459,
          "afterBytes": 128,
          "beforeText": "    balance?.disconnect();codeFade?.disconnect();songInput?.disconnect();master?.disconnect();\n"
        },
        {
          "afterOffset": 5051,
          "afterBytes": 294,
          "beforeText": "    node.connect(balance);balance.connect(codeFade);codeFade.connect(master);songInput.connect(master);master.connect(context.destination);\n"
        }
      ]
    },
