{
  "schemaVersion": 1,
  "scope": "scsp-synth-acyclic-custom-multi-operator-fm",
  "baseCommit": "81f5e7e591e4fdbf6f375ea97061eb6c514f3e97",
  "review": "Acyclic Custom 4/6OP and two-input routing with deterministic dependency-ordered physical slots. Complete reviewed source bodies and dependencies are pinned; all legacy PCM, fixed FM and twelve Custom2 graph/output cases retain exact native output, RAM, state, registers, writes and v4/v5 exports at 44.1/48 kHz. Common runtime, WASM, gains and historical reports remain unchanged.",
  "sources": {
    "docs/synth-scsp/routing.js": {
      "before": {
        "bytes": 4859,
        "sha256": "38edc71d46015b51c961f66e1775b84cb80d053c8c353dca3b36ed286a0c89cc"
      },
      "after": {
        "bytes": 6396,
        "sha256": "726ab675210602ee56d52446bcea0c891e76009f0a5124cb7cc8b42330dee47b"
      },
      "reverseHunks": [
        {
          "afterOffset": 459,
          "afterBytes": 995,
          "beforeText": "/** Initial custom editor: independent A/B inputs and outputs, without feedback.\n * This is a Synth graph constraint, not a hardware limitation. */\nexport function customRouting(value){\n"
        },
        {
          "afterOffset": 1791,
          "afterBytes": 303,
          "beforeText": "  if(!denseArray(rawInputs,2))throw new TypeError('Custom 2-op FM requires inputs for A and B');\n"
        },
        {
          "afterOffset": 2148,
          "afterBytes": 343,
          "beforeText": "    if(!Array.isArray(entry)||entry.length>1||!denseArray(entry,entry.length))throw new TypeError('Each custom 2-op input must be empty or one operator');\n    return Array.from(entry,source=>{\n      if(!Number.isInteger(source)||source<0||source>1)throw new RangeError('Custom 2-op source must be A or B');\n"
        },
        {
          "afterOffset": 2623,
          "afterBytes": 132,
          "beforeText": ""
        },
        {
          "afterOffset": 2761,
          "afterBytes": 387,
          "beforeText": "  if(inputs[0].length&&inputs[1].length)throw new RangeError('Feedback loops are outside this acyclic Synth editor');\n  if(!Array.isArray(rawOutputs)||rawOutputs.length>2||!denseArray(rawOutputs,rawOutputs.length))throw new TypeError('Custom outputs must be a dense A/B list');\n  const outputs=Array.from(rawOutputs,output=>{if(!Number.isInteger(output)||output<0||output>1)throw new RangeError('Custom output must be A or B');return output;});\n"
        },
        {
          "afterOffset": 3313,
          "afterBytes": 420,
          "beforeText": ""
        },
        {
          "afterOffset": 3887,
          "afterBytes": 150,
          "beforeText": "    if(config.mode!=='fm2')throw new TypeError('Custom connections currently require 2-op FM');\n    return {count,...customRouting(config.fm.custom)};\n"
        },
        {
          "afterOffset": 4652,
          "afterBytes": 130,
          "beforeText": "  const graph=routing(config),order=graph.inputs[1].includes(0)?[0,1]:[1,0];\n  return [slots[order.indexOf(0)],slots[order.indexOf(1)]];\n"
        }
      ]
    },
