  "behavior": {
    "spu": {
      "firstEdit": "Inverted copy-on-write: preserve running physical address A, back up original ADPCM to B under its immutable original ID, and bind a private editor ID to A using JS metadata only.",
      "repeatedEdit": "Overwrite the same private live slot; no KON/KOFF, Start/Repeat/ADSR rewrite, output/resampler reset or note-owner change.",
      "spareReuse": "A same-length spare is reused only if no logical/raw pointer and no native ENV/software gate could still reference it. This protects decoders whose programmed Start already describes the next note.",
      "originalSound": "Original bytes/tuning/immutable ID remain reusable by VAB cached .id objects and findADPCM. Previous raw physical address snapshots are historical.",
      "code": "Authoring keeps the existing Code Stop/checkpoint-restore policy; malformed/stale/over-budget preflight does not retire a Code checkpoint."
    },
    "sdsp": {
      "waveEdit": "Encode the active 128-point Wave to 72 BRR bytes and overwrite its existing sample address; prepare both carrier/modulator edits before writing either.",
      "preserved": [
        "logical held/release owners",
        "sample metadata and tuning",
        "nativeFrames and generation",
        "BRR decoder/interpolation history",
        "hardware envelopes",
        "PMON and Echo RAM/history"
      ],
      "dormantDrafts": "Wave drafts under Noise/BRR or inactive PMON do not write native RAM or registers.",
      "replacement": "Explicit preset/audio/BRR loading, source/loop/topology/Echo-layout changes retain their existing bank replacement behavior."
    }
  },
