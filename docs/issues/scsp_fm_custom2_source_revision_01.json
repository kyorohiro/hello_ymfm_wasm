          "beforeText": ""
        },
        {
          "afterOffset": 2899,
          "afterBytes": 503,
          "beforeText": "// Every edge points from a higher operator index to a lower one. Reverse slot\n// order therefore makes each source available in the zero-delay core's stack.\n"
        },
        {
          "afterOffset": 3453,
          "afterBytes": 234,
          "beforeText": "  const {count,inputs,outputs}=routing(config),state=synth.getState(),frequency=440*2**((group.midi-69+config.transpose)/12),commands=[];\n"
        },
        {
          "afterOffset": 3730,
          "afterBytes": 110,
          "beforeText": "    const voice=state.slots[index],slot=group.slots[count-1-index],sources=inputs[index];\n"
        },
        {
          "afterOffset": 4001,
          "afterBytes": 104,
          "beforeText": "    const offsets=sources.map(source=>(group.slots[count-1-source]-slot+64)%64);\n"
        },
        {
          "afterOffset": 4613,
          "afterBytes": 246,
          "beforeText": "export function operatorSlot(group,index){return index<group.slots.length?group.slots[group.slots.length-1-index]:null;}\n"
        }
      ]
    },
