          "beforeText": "  if(self.length&&(length!==2||self.length!==1||inputs.some(sources=>sources.length>1)))\n    throw new RangeError('Self feedback requires Custom 2-op, one self operator and at most one source per operator');\n"
        },
        {
          "afterOffset": 4433,
          "afterBytes": 163,
          "beforeText": "  return {inputs:Array.from({length:count},(_,index)=>(graph.inputs[index]??[]).filter(source=>source<count&&(count===2||source!==index))),outputs:graph.outputs.filter(output=>output<count)};\n"
        }
      ]
