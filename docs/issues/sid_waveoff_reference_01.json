{
  "schemaVersion": 1,
  "passed": true,
  "purpose": "Independent primary-source and external-engine evidence for oscillator phase with no selected waveform; not an analog DAC timing fit",
  "datasheet": {
    "title": "MOS Technology 6581 Sound Interface Device",
    "url": "https://myoldcomputer.nl/Files/mos_6581_sid.pdf",
    "bytes": 8293183,
    "sha256": "0039abf5407b1725b72b0a6418efd37ed2b36577e00035438753754af11f1730",
    "pdfPages": [
      4,
      5
    ],
    "facts": [
      "Page4: Gate controls the envelope attack/release sequence. TEST resets and holds the oscillator at zero.",
      "Page4: source oscillator frequency drives Sync and Ring; the remaining source-voice parameters do not determine these effects.",
      "Page5: the oscillator dependency rotates 3→1, 1→2 and 2→3."
    ],
    "limit": "The datasheet does not specify a waveform-off DAC floating-decay curve or per-cycle phase implementation."
  },
