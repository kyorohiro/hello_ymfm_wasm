    "observations": [
      {
        "file": "src/WaveformGenerator.h",
        "lines": [
          315,
          374
        ],
        "fact": "Clocking advances phase and the noise pipeline whenever TEST is clear; waveform selection and Gate do not gate that clock."
      },
      {
        "file": "src/WaveformGenerator.h",
        "lines": [
          379,
          425
        ],
        "fact": "Ring uses the preceding accumulator MSB. Waveform-off aging affects a separate output latch."
      },
      {
        "file": "src/WaveformGenerator.cpp",
        "lines": [
          338,
          345
        ],
        "fact": "Hard Sync follows a source MSB edge, including the simultaneous source-sync suppression case."
      },
      {
        "file": "src/WaveformGenerator.cpp",
        "lines": [
          354,
          422
        ],
        "fact": "Selecting no waveform starts model-dependent output decay. TEST resets phase separately; latch fading does not rewrite phase."
      },
      {
        "file": "src/Voice.h",
        "lines": [
          67,
          76
        ],
        "fact": "Oscillator DAC output and envelope output enter the amplitude path separately."
      }
    ]
  },
