        {
          "afterOffset": 1718,
          "afterBytes": 109,
          "beforeText": "export async function createScspCycle2UiRevisionReceipt(){\n"
        },
        {
          "afterOffset": 1900,
          "afterBytes": 410,
          "beforeText": " for(const name of paths){before[name]=historical(name);after[name]=await readFile(resolve(root,name));assert(!before[name].equals(after[name]),'Expected reviewed UI source change: '+name);sources[name]={beforeCommit:predecessors[name]??base,before:record(before[name]),after:record(after[name]),reverseHunks:reverseHunks(before[name],after[name])};}\n const example=await readFile(resolve(root,'docs/synth-scsp/examples/cycle2.js'));\n"
        },
        {
          "afterOffset": 2382,
          "afterBytes": 533,
          "beforeText": " for(const name of related){const bytes=await readFile(resolve(root,name));if(unchanged.includes(name))assert.deepEqual(bytes,historical(name),'Audio/default/runtime inputs stay byte-identical: '+name);relatedSources[name]=record(bytes);}\n for(const name of reports){const bytes=await readFile(resolve(root,name));assert.deepEqual(bytes,historical(name),'Existing native/source evidence remains immutable: '+name);reportRecords[name]=record(bytes);}\n const original=JSON.parse(await readFile(resolve(root,'docs/issues/scsp_fm_multiple_self_source_revision_01.json'),'utf8'));\n"
        },
        {
          "afterOffset": 4301,
          "afterBytes": 229,
          "beforeText": " const value=await createScspCycle2UiRevisionReceipt(),text=JSON.stringify(value,null,2)+'\\n';\n"
        }
      ]
    }
